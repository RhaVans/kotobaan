<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_voice_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_dialog_voice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Pengaturan Suara Jepang"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_dialog_voice_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Karakter Asisten Sistem &amp; Tutor Bahasa"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_dialog_voice_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Voice Info Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_button_secondary"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Profil Suara:"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txt_voice_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="Female · System (ja-JP)"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_voice_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Suara wanita Jepang native, tenang, presisi &amp; natural"
            android:textColor="@color/colorTextTertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Speed Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="Kecepatan Bicara (Speed):"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/container_speed_chips"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_segmented_container"
        android:orientation="horizontal"
        android:padding="2dp">

        <Button
            android:id="@+id/btn_speed_075"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif-medium"
            android:text="0.75×"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_speed_085"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif-medium"
            android:text="0.85×"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_speed_090"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segmented_active"
            android:fontFamily="sans-serif-medium"
            android:text="0.90×"
            android:textAllCaps="false"
            android:textColor="@color/colorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_speed_100"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif-medium"
            android:text="1.00×"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_speed_110"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif-medium"
            android:text="1.10×"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Pitch Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="Nada Suara (Pitch):"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/container_pitch_chips"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_segmented_container"
        android:orientation="horizontal"
        android:padding="2dp">

        <Button
            android:id="@+id/btn_pitch_lower"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif-medium"
            android:text="Rendah (0.88×)"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_pitch_normal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segmented_active"
            android:fontFamily="sans-serif-medium"
            android:text="Tenang (0.95×)"
            android:textAllCaps="false"
            android:textColor="@color/colorOnPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_pitch_higher"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif-medium"
            android:text="Tinggi (1.05×)"
            android:textAllCaps="false"
            android:textColor="@color/colorTextSecondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Test Voice Button -->
    <Button
        android:id="@+id/btn_test_voice"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_primary"
        android:fontFamily="sans-serif-medium"
        android:text="Uji Suara: こんにちは。日本語を一緒に勉強しましょう。"
        android:textAllCaps="false"
        android:textColor="@color/colorOnPrimary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Open System TTS Settings Button -->
    <Button
        android:id="@+id/btn_system_tts_settings"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_secondary"
        android:fontFamily="sans-serif"
        android:text="Buka Pengaturan Suara Sistem Android"
        android:textAllCaps="false"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp" />
</LinearLayout>
