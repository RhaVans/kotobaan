<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingRight="@dimen/screen_padding_horizontal"
        android:paddingBottom="6dp">

        <!-- Title and Counter Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_app_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="@string/app_name"
                android:textColor="@color/colorTextPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_card_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:fontFamily="sans-serif-medium"
                android:text="1 / 863"
                android:textColor="@color/colorBadgeText"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Author Subtitle -->
        <TextView
            android:id="@+id/txt_app_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="@string/app_author"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp" />

        <!-- Segmented Section Switcher (Kosakata vs Kanji) -->
        <LinearLayout
            android:id="@+id/section_switcher_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_section_switcher"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_segmented_container"
            android:orientation="horizontal"
            android:padding="2dp">

            <Button
                android:id="@+id/btn_section_kotoba"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_active"
                android:fontFamily="sans-serif-medium"
                android:text="@string/section_kotoba"
                android:textAllCaps="false"
                android:textColor="@color/colorOnPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_section_kanji"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:text="@string/section_kanji"
                android:textAllCaps="false"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sub-segmented Switcher for Kanji: [ 613 Formal ] vs [ Tambahan ] -->
        <LinearLayout
            android:id="@+id/kanji_subsection_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_kanji_sub_switcher"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_segmented_container"
            android:orientation="horizontal"
            android:padding="2dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_kanji_sub_613"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_active"
                android:fontFamily="sans-serif-medium"
                android:text="@string/kanji_sub_613"
                android:textAllCaps="false"
                android:textColor="@color/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_kanji_sub_additional"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:text="@string/kanji_sub_additional"
                android:textAllCaps="false"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sub-segmented Reading Mode Switcher for Kanji: [ On'yomi | Kun'yomi | Keduanya ] -->
        <LinearLayout
            android:id="@+id/kanji_reading_mode_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_kanji_sub_switcher"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_segmented_container"
            android:orientation="horizontal"
            android:padding="2dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_main_kanji_mode_onyomi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:text="@string/kanji_reading_mode_onyomi"
                android:textAllCaps="false"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_main_kanji_mode_kunyomi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:text="@string/kanji_reading_mode_kunyomi"
                android:textAllCaps="false"
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_main_kanji_mode_both"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_active"
                android:fontFamily="sans-serif-medium"
                android:text="@string/kanji_reading_mode_both"
                android:textAllCaps="false"
                android:textColor="@color/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Deck Status Line -->
        <TextView
            android:id="@+id/txt_deck_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Bab 1-25 • 863 kata"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp" />

        <!-- Deck Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_deck"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="1"
            android:progressTint="@color/colorPrimary" />
    </LinearLayout>

    <!-- Center Card Canvas -->
    <FrameLayout
        android:id="@+id/card_wrapper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/card_margin_horizontal"
        android:layout_marginTop="@dimen/card_margin_vertical"
        android:layout_marginRight="@dimen/card_margin_horizontal"
        android:layout_marginBottom="@dimen/card_margin_vertical"
        android:layout_weight="1">

        <com.kotoba.app.ui.FlashcardView
            android:id="@+id/flashcard_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Bottom Control Container -->
    <LinearLayout
        android:id="@+id/bottom_control_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_padding_horizontal"
        android:paddingRight="@dimen/screen_padding_horizontal"
        android:paddingBottom="@dimen/screen_padding_bottom">

        <!-- Segmented Front Mode Bar -->
        <LinearLayout
            android:id="@+id/segmented_mode_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_segmented_mode_bar"
            android:layout_marginBottom="@dimen/dock_margin_bottom"
            android:background="@drawable/bg_segmented_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/btn_mode_kanji"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_active"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_mode_kanji"
                android:textAllCaps="false"
                android:textColor="@color/colorOnPrimary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_mode_hiragana"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_mode_hiragana"
                android:textAllCaps="false"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_mode_arti"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_mode_arti"
                android:textAllCaps="false"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Action Toolbar -->
        <LinearLayout
            android:id="@+id/bottom_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_bottom_toolbar"
            android:layout_marginBottom="@dimen/dock_margin_bottom"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp">

            <ImageButton
                android:id="@+id/btn_furigana_toggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_furigana"
                android:minWidth="@dimen/min_touch_target"
                android:minHeight="@dimen/min_touch_target"
                android:src="@drawable/ic_furigana" />

            <ImageButton
                android:id="@+id/btn_romaji_toggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_romaji"
                android:minWidth="@dimen/min_touch_target"
                android:minHeight="@dimen/min_touch_target"
                android:src="@drawable/ic_romaji" />

            <ImageButton
                android:id="@+id/btn_filter_bab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_filter"
                android:minWidth="@dimen/min_touch_target"
                android:minHeight="@dimen/min_touch_target"
                android:src="@drawable/ic_filter" />

            <ImageButton
                android:id="@+id/btn_shuffle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_shuffle"
                android:minWidth="@dimen/min_touch_target"
                android:minHeight="@dimen/min_touch_target"
                android:src="@drawable/ic_shuffle" />

            <ImageButton
                android:id="@+id/btn_theme_toggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_theme"
                android:minWidth="@dimen/min_touch_target"
                android:minHeight="@dimen/min_touch_target"
                android:src="@drawable/ic_theme_toggle" />

            <ImageButton
                android:id="@+id/btn_sound_toggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_sound"
                android:minWidth="@dimen/min_touch_target"
                android:minHeight="@dimen/min_touch_target"
                android:src="@drawable/ic_volume_up" />
        </LinearLayout>

        <!-- Navigation Dock (Prev / Balik / Next) -->
        <LinearLayout
            android:id="@+id/bottom_nav_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dock_margin_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_prev"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_nav_dock_button"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:fontFamily="sans-serif-medium"
                android:minWidth="@dimen/min_touch_target"
                android:minHeight="@dimen/min_touch_target"
                android:text="Prev"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_flip"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_nav_dock_button"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-medium"
                android:minWidth="@dimen/min_touch_target"
                android:minHeight="@dimen/min_touch_target"
                android:text="@string/action_flip"
                android:textColor="@color/colorOnPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_nav_dock_button"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:fontFamily="sans-serif-medium"
                android:minWidth="@dimen/min_touch_target"
                android:minHeight="@dimen/min_touch_target"
                android:text="Next"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Ingat / Lupa Active Recall Dock -->
        <LinearLayout
            android:id="@+id/layout_ingat_lupa_dock"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_recall_dock_button"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_lupa"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="@dimen/min_touch_target"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/action_lupa"
                    android:src="@drawable/ic_close"
                    android:tint="@color/colorError" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/action_lupa"
                    android:textColor="@color/colorError"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_ingat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="@dimen/min_touch_target"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/action_ingat"
                    android:src="@drawable/ic_check"
                    android:tint="@color/colorOnPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/action_ingat"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
